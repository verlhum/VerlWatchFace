            slotId="1"
            name="12_oclock_battery"
            displayName="@string/battery_complication_name"
            supportedTypes="RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            x="180" y="60" width="90" height="90">
            <BoundingOval x="0" y="0" width="90" height="90" />
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />

            <Complication type="RANGED_VALUE">
                <!-- Dim Green Background Track -->
                <PartDraw x="0" y="0" width="90" height="90">
                    <Arc centerX="45" centerY="45" width="80" height="80" startAngle="0" endAngle="360">
                        <Stroke color="#1A331A" thickness="3" />
                    </Arc>
                </PartDraw>
                <!-- Bright Green Dynamic Progress Arc (Fills Clockwise from 12 o'clock / 0°) -->
                <PartDraw x="0" y="0" width="90" height="90">
                    <Arc centerX="45" centerY="45" width="80" height="80" startAngle="0" endAngle="0">
                        <Transform target="endAngle" value="clamp([BATTERY_PERCENT] / 100.0, 0, 1) * 360" />
                        <Stroke color="#00FF66" thickness="3" />
                    </Arc>
